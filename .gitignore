# ─── Environnements & caches Python ───────────────────────────────
.venv-whisper/
.venv/
__pycache__/
*.py[cod]

# ─── Données personnelles (NE JAMAIS PUBLIER) ─────────────────────
dashboard/mes_reponses/
dashboard/mes_simulations_co/
dashboard/mes_simulation_expression_oral/
dashboard/mes_audios/
dashboard/tests/

# ─── Contenu de tiers : la banque et les sujets ───────────────────
# Seul le dossier banque/exemple/ est publié (1 question + 1 audio + 1 image).
dashboard/banque/*
!dashboard/banque/exemple/
dashboard/questions.js
dashboard/questions_oral.js
dashboard/sujets_oraux.json
*.log

# … mais on garde bien les fichiers d'exemple :
!dashboard/questions.exemple.js
!dashboard/questions_oral.exemple.js
!dashboard/sujets_oraux.exemple.json

# ─── Clé de signature de l'APK (SECRET — jamais sur GitHub) ───────
app-mobile/cle.keystore
*.keystore
*.jks

# ─── Artéfacts de compilation Android ─────────────────────────────
app-mobile/build/
*.apk
*.idsig
*.dex

# ─── Divers ───────────────────────────────────────────────────────
dashboard/site/.git-ancien-sauvegarde/
.DS_Store
*.swp

# Les 60 sujets en dur dans l'appli : seul l'exemple est publié.
app-mobile/src/com/katherine/tcforal/Sujets.java
!app-mobile/src/com/katherine/tcforal/Sujets.exemple.java
